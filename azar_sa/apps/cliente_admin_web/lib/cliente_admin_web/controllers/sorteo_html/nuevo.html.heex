<.app flash={@flash}>
  <div class="max-w-2xl mx-auto">
    <div class="flex items-center gap-3 mb-6">
      <a href={~p"/"} class="btn btn-ghost btn-sm btn-circle">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
      </a>
      <h1 class="text-2xl font-bold text-base-content">Nuevo Sorteo</h1>
    </div>

    <div class="card bg-base-100 shadow-md border border-base-300">
      <div class="card-body">
        <form action="/sorteos" method="post" class="space-y-4">
          <input type="hidden" name="_csrf_token" value={get_csrf_token()} />

          <div class="form-control">
            <label class="label"><span class="label-text font-semibold">Nombre del sorteo</span></label>
            <input type="text" name="nombre" value={@changeset.changes[:nombre] || ""}
              class="input input-bordered w-full" required minlength="2" maxlength="120"
              placeholder="Ej. Lotería Nacional" />
          </div>

          <div class="form-control">
            <label class="label"><span class="label-text font-semibold">Fecha y hora del sorteo (UTC)</span></label>
            <input type="datetime-local" name="fecha" value={@changeset.changes[:fecha] || ""}
              class="input input-bordered w-full" required />
          </div>

          <div class="grid grid-cols-3 gap-4">
            <div class="form-control">
              <label class="label"><span class="label-text font-semibold">Valor billete ($)</span></label>
              <input type="number" name="valor_billete" id="n-val"
                value={@changeset.changes[:valor_billete] || ""} min="1"
                class="input input-bordered w-full" required />
            </div>
            <div class="form-control">
              <label class="label"><span class="label-text font-semibold">Fracciones</span></label>
              <input type="number" name="fracciones" id="n-frac"
                value={@changeset.changes[:fracciones] || ""} min="1"
                class="input input-bordered w-full" required />
            </div>
            <div class="form-control">
              <label class="label"><span class="label-text font-semibold">Billetes</span></label>
              <input type="number" name="cantidad_billetes" id="n-cant"
                value={@changeset.changes[:cantidad_billetes] || ""} min="1"
                class="input input-bordered w-full" required />
            </div>
          </div>

          <%!-- Calculadora compacta: siempre visible --%>
          <div id="n-calc" class="rounded-lg border border-primary/25 bg-primary/5 p-4 flex flex-col md:flex-row justify-between items-center gap-4 text-sm">
            <div class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary/70" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
              <span class="text-primary/70 font-semibold text-xs uppercase tracking-wide">Proyección Financiera</span>
            </div>
            <div class="flex flex-wrap gap-x-6 gap-y-2 items-center">
              <span class="text-base-content/70">Precio/fracc: <strong id="n-cp" class="text-info font-bold">—</strong></span>
              <span class="text-base-content/70">Fracciones: <strong id="n-ct" class="text-base-content font-bold">—</strong></span>
              <span class="font-semibold border-l pl-6 border-base-300">Ganancia potencial: <strong id="n-cg" class="text-success text-base">—</strong></span>
            </div>
          </div>

          <div class="divider text-xs text-base-content/40">Descripción de Premios</div>

          <div class="form-control">
            <label class="label"><span class="label-text font-semibold">Premio por billete completo</span></label>
            <textarea name="descripcion_premio_completo" class="textarea textarea-bordered w-full" rows="2"
              placeholder="Qué gana si tiene todas las fracciones del billete ganador..."><%= @changeset.changes[:descripcion_premio_completo] || "" %></textarea>
          </div>

          <div class="form-control">
            <label class="label"><span class="label-text font-semibold">Premio por fracción</span></label>
            <textarea name="descripcion_premio_fraccion" class="textarea textarea-bordered w-full" rows="2"
              placeholder="Qué gana si tiene una fracción del billete ganador..."><%= @changeset.changes[:descripcion_premio_fraccion] || "" %></textarea>
          </div>

          <div class="pt-2">
            <button type="submit" class="btn btn-primary w-full">Crear Sorteo</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script>
    (function() {
      var v=document.getElementById('n-val'), f=document.getElementById('n-frac'), c=document.getElementById('n-cant');
      var box=document.getElementById('n-calc'), cp=document.getElementById('n-cp'), ct=document.getElementById('n-ct'), cg=document.getElementById('n-cg');
      function fmt(n){return '$'+n.toLocaleString('es-CO');}
      function calc(){
        var val=parseInt(v.value)||0, fr=parseInt(f.value)||0, cn=parseInt(c.value)||0;
        if(val>0&&fr>0&&cn>0){
          var pf=Math.floor(val/fr), tot=fr*cn;
          cp.textContent=fmt(pf); ct.textContent=tot.toLocaleString('es-CO'); cg.textContent=fmt(pf*tot);
        } else {
          cp.textContent='—'; ct.textContent='—'; cg.textContent='—';
        }
      }
      [v,f,c].forEach(function(el){if(el)el.addEventListener('input',calc);});
      calc();
    })();
  </script>
</.app>
