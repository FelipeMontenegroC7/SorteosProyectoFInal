<.app flash={@flash}>
  <div class="space-y-6">
    <h1 class="text-3xl font-bold text-base-content">Lista de Clientes</h1>

    <div class="card bg-base-100 shadow-md border border-base-300 overflow-hidden">
      <%= if @clientes == [] do %>
        <div class="py-12 text-center text-base-content/50">
          <p class="text-lg">No hay clientes registrados.</p>
        </div>
      <% else %>
        <div class="overflow-x-auto">
          <table class="table w-full">
            <thead>
              <tr class="border-b border-base-300">
                <th class="font-semibold">Usuario</th>
                <th class="font-semibold">Créditos</th>
                <th class="font-semibold">Ingresado</th>
                <th class="font-semibold">Gastado</th>
                <th class="font-semibold">Fracciones</th>
                <th class="font-semibold">Billetes Completos</th>
                <th class="font-semibold">Acciones</th>
              </tr>
            </thead>
            <tbody>
              <%= for c <- @clientes do %>
                <tr class="hover:bg-base-200/50 border-b border-base-300/50">
                  <td class="font-semibold">{c.usuario}</td>
                  <td><span class="badge badge-success badge-sm">$<%= c.creditos %></span></td>
                  <td class="text-success">+$<%= c.ingresado %></td>
                  <td class="text-error">-$<%= c.gastado %></td>
                  <td><%= c.total_compras %></td>
                  <td>
                    <%= if c.billetes_completos > 0 do %>
                      <span class="badge badge-primary badge-sm"><%= c.billetes_completos %></span>
                    <% else %>
                      <span class="text-base-content/30">0</span>
                    <% end %>
                  </td>
                  <td>
                    <a href={"/clientes/#{c.usuario}"} class="btn btn-ghost btn-xs">Ver detalle</a>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>
  </div>
</.app>
