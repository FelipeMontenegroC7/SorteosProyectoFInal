<.app flash={@flash}>
  <div class="space-y-6">
    <%!-- Header --%>
    <div class="flex items-center gap-3">
      <a href={~p"/clientes"} class="btn btn-ghost btn-sm btn-circle">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
      </a>
      <div>
        <h1 class="text-3xl font-bold text-base-content">{@usuario}</h1>
        <p class="text-base-content/60 text-sm">Detalle del jugador</p>
      </div>
    </div>

    <%!-- Stats cards --%>
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
      <div class="card bg-base-100 shadow-md border border-base-300">
        <div class="card-body py-4 items-center text-center">
          <p class="text-xs text-base-content/50 uppercase font-semibold">Créditos</p>
          <p class="text-2xl font-bold text-success">$<%= Map.get(@user, "creditos", 0) %></p>
        </div>
      </div>
      <div class="card bg-base-100 shadow-md border border-base-300">
        <div class="card-body py-4 items-center text-center">
          <p class="text-xs text-base-content/50 uppercase font-semibold">Ingresado</p>
          <p class="text-2xl font-bold text-base-content">$<%= Map.get(@user, "ingresado", 0) %></p>
        </div>
      </div>
      <div class="card bg-base-100 shadow-md border border-base-300">
        <div class="card-body py-4 items-center text-center">
          <p class="text-xs text-base-content/50 uppercase font-semibold">Gastado</p>
          <p class="text-2xl font-bold text-error">$<%= @valor_fracciones %></p>
        </div>
      </div>
      <div class="card bg-base-100 shadow-md border border-base-300">
        <div class="card-body py-4 items-center text-center">
          <p class="text-xs text-base-content/50 uppercase font-semibold">Ganancias</p>
          <p class={"text-2xl font-bold #{if @ganancias > 0, do: "text-success", else: "text-base-content/30"}"}>
            $<%= @ganancias %>
          </p>
        </div>
      </div>
    </div>

    <%!-- Resumen de compras --%>
    <div class="card bg-base-100 shadow-md border border-base-300">
      <div class="card-body">
        <h2 class="card-title text-lg mb-2">Resumen de Actividad</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-sm">
          <div class="flex justify-between border-b border-base-300 pb-2 sm:border-0 sm:flex-col sm:items-center">
            <span class="text-base-content/60">Fracciones compradas</span>
            <span class="font-bold text-lg"><%= @total_fracciones %></span>
          </div>
          <div class="flex justify-between border-b border-base-300 pb-2 sm:border-0 sm:flex-col sm:items-center">
            <span class="text-base-content/60">Valor total compras</span>
            <span class="font-bold text-lg">$<%= @valor_fracciones %></span>
          </div>
          <div class="flex justify-between sm:flex-col sm:items-center">
            <span class="text-base-content/60">Sorteos participados</span>
            <span class="font-bold text-lg"><%= length(@nombres_sorteos) %></span>
          </div>
        </div>
      </div>
    </div>

    <%!-- Compras por sorteo --%>
    <div class="card bg-base-100 shadow-md border border-base-300">
      <div class="card-body">
        <h2 class="card-title text-lg mb-4">Compras por Sorteo</h2>
        <%= if @ventas_jugador == [] do %>
          <p class="text-base-content/50 text-sm py-4 text-center">Este jugador no tiene compras registradas.</p>
        <% else %>
          <div class="space-y-4">
            <%= for {sorteo_nombre, ventas} <- @ventas_por_sorteo do %>
              <div class="collapse collapse-arrow bg-base-200/50 border border-base-300 rounded-xl">
                <input type="checkbox" />
                <div class="collapse-title font-bold flex items-center gap-3">
                  <span>{sorteo_nombre}</span>
                  <span class="badge badge-outline badge-sm"><%= length(ventas) %> fracciones</span>
                </div>
                <div class="collapse-content px-0">
                  <div class="overflow-x-auto">
                    <table class="table table-sm w-full">
                      <thead>
                        <tr class="border-b border-base-300">
                          <th>Billete</th>
                          <th>Fracción</th>
                          <th>Fecha</th>
                        </tr>
                      </thead>
                      <tbody>
                        <%= for %{venta: v} <- ventas do %>
                          <tr class="hover:bg-base-200/50">
                            <td class="font-mono font-bold">#<%= v.billete %></td>
                            <td class="font-mono">F<%= v.fraccion %></td>
                            <td class="text-xs text-base-content/50 whitespace-nowrap">
                              <%= String.replace(String.slice(v.inserted_at || "", 0, 19), "T", " ") %>
                            </td>
                          </tr>
                        <% end %>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</.app>
