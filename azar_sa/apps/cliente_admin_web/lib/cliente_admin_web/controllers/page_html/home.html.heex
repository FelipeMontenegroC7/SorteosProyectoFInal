<.app flash={@flash}>
  <div class="space-y-8">
    <%!-- Header --%>
    <div>
      <h1 class="text-3xl font-bold text-base-content">Panel de Control</h1>
      <p class="text-base-content/60 mt-1">Resumen general de sorteos y ventas</p>
    </div>

    <%!-- Estadísticas --%>
    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">
      <div class="card bg-base-100 shadow-md border border-base-300 hover:shadow-lg transition-shadow">
        <div class="card-body py-5">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
            </div>
            <div>
              <p class="text-xs text-base-content/50 uppercase font-semibold tracking-wide">Total Sorteos</p>
              <p class="text-2xl font-bold text-base-content"><%= @stats.total_sorteos %></p>
            </div>
          </div>
        </div>
      </div>

      <div class="card bg-base-100 shadow-md border border-base-300 hover:shadow-lg transition-shadow">
        <div class="card-body py-5">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-success/10 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" /></svg>
            </div>
            <div>
              <p class="text-xs text-base-content/50 uppercase font-semibold tracking-wide">Fracciones Vendidas</p>
              <p class="text-2xl font-bold text-success"><%= @stats.ventas_total %></p>
            </div>
          </div>
        </div>
      </div>

      <div class="card bg-base-100 shadow-md border border-base-300 hover:shadow-lg transition-shadow">
        <div class="card-body py-5">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-accent/10 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
            <div>
              <p class="text-xs text-base-content/50 uppercase font-semibold tracking-wide">Ingresos</p>
              <p class="text-2xl font-bold text-accent">$<%= @stats.ingresos %></p>
            </div>
          </div>
        </div>
      </div>

      <div class="card bg-base-100 shadow-md border border-base-300 hover:shadow-lg transition-shadow">
        <div class="card-body py-5">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-info/10 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-info" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
            <div>
              <p class="text-[10px] text-base-content/50 uppercase font-semibold tracking-wide">Activos / Pend. / Fin.</p>
              <p class="text-2xl font-bold text-base-content" title="Activos / Pendientes / Finalizados">
                <span class="text-success"><%= @stats.activos %></span> / 
                <span class="text-warning"><%= @stats.pendientes %></span> / 
                <span class="text-base-content/40"><%= @stats.finalizados %></span>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <%!-- Tabla de sorteos --%>
    <div class="card bg-base-100 shadow-md border border-base-300 overflow-hidden">
      <div class="px-6 py-4 border-b border-base-300 flex items-center justify-between">
        <h2 class="text-xl font-bold text-base-content">Sorteos Registrados</h2>
        <div class="flex items-center gap-4">
          <div class="form-control">
            <label class="label cursor-pointer gap-2">
              <span class="label-text text-xs font-semibold text-base-content/60">Ocultar finalizados</span>
              <input type="checkbox" class="toggle toggle-primary toggle-sm" id="toggle-finished" />
            </label>
          </div>
          <a href={~p"/sorteos/nuevo"} class="btn btn-primary btn-sm gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
            Nuevo
          </a>
        </div>
      </div>

      <%= if @sorteos == [] do %>
        <div class="p-12 text-center text-base-content/50">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 mx-auto mb-4 opacity-30" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
          <p class="text-lg font-medium">No hay sorteos aún</p>
          <p class="mt-1">
            <a href={~p"/sorteos/nuevo"} class="link link-primary font-semibold">Crear el primero →</a>
          </p>
        </div>
      <% else %>
        <div class="overflow-x-auto">
          <table class="table w-full">
            <thead>
              <tr class="border-b border-base-300">
                <th class="text-base-content/70 font-semibold">Nombre</th>
                <th class="text-base-content/70 font-semibold">
                  <a href={"?orden=#{if assigns[:orden] == "asc", do: "desc", else: "asc"}"} class="flex items-center gap-1 hover:text-primary transition-colors">
                    Fecha
                    <%= if assigns[:orden] == "asc" do %>
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" /></svg>
                    <% else %>
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                    <% end %>
                  </a>
                </th>
                <th class="text-base-content/70 font-semibold">Valor Billete</th>
                <th class="text-base-content/70 font-semibold">Fracciones</th>
                <th class="text-base-content/70 font-semibold">Ventas</th>
                <th class="text-base-content/70 font-semibold">Recaudado</th>
                <th class="text-base-content/70 font-semibold">Gan. Potencial</th>
                <th class="text-base-content/70 font-semibold">Estado</th>
                <th class="text-base-content/70 font-semibold">Acciones</th>
              </tr>
            </thead>
            <tbody>
              <%= for s <- @sorteos do %>
                <%
                  precio_f = if s.fracciones > 0, do: div(s.valor_billete, s.fracciones), else: 0
                  recaudado = precio_f * length(s.ventas)
                  total_fracs = s.cantidad_billetes * s.fracciones
                  ganancia_potencial = precio_f * total_fracs
                %>
                <tr class={"hover:bg-base-200/50 border-b border-base-300/50 transition-colors #{if s.estado == :finalizado, do: "finished-sorteo", else: "active-sorteo"}"} >
                  <td class="font-semibold text-base-content"><%= s.nombre %></td>
                  <td class="text-sm">
                    <% {fecha_fmt, hora_fmt} = formatear_fecha_hora(s.fecha) %>
                    <span class="text-base-content/80 font-medium"><%= fecha_fmt %></span>
                    <%= if hora_fmt != "" do %>
                      <span class="text-primary font-bold ml-1 whitespace-nowrap"><%= hora_fmt %></span>
                    <% end %>
                  </td>
                  <td class="font-medium">$<%= s.valor_billete %></td>
                  <td><%= s.fracciones %></td>
                  <td><span class="badge badge-outline badge-sm"><%= length(s.ventas) %></span></td>
                  <td class="font-bold text-accent">$<%= recaudado %></td>
                  <td class="font-bold text-success text-sm">$<%= ganancia_potencial %></td>
                  <td>
                    <%= if s.estado == :activo do %>
                      <span class="badge badge-success badge-sm gap-1">
                        <span class="w-1.5 h-1.5 rounded-full bg-success-content animate-pulse"></span>
                        Activo
                      </span>
                    <% else %>
                      <%= if s.estado == :pendiente do %>
                        <span class="badge badge-warning badge-sm gap-1">
                          Pendiente
                        </span>
                      <% else %>
                        <span class="badge badge-neutral badge-sm">Finalizado</span>
                      <% end %>
                    <% end %>
                  </td>
                  <td>
                    <div class="flex gap-1">
                      <a href={"/sorteos/#{s.nombre}"} class="btn btn-ghost btn-xs">Ver</a>
                      <%= if s.estado in [:activo, :pendiente] do %>
                        <a href={"/sorteos/#{s.nombre}/editar"} class="btn btn-ghost btn-xs">Editar</a>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", function() {
      const toggle = document.getElementById("toggle-finished");
      if (!toggle) return;

      toggle.addEventListener("change", function() {
        const finishedRows = document.querySelectorAll(".finished-sorteo");
        finishedRows.forEach(row => {
          if (this.checked) {
            row.classList.add("hidden");
          } else {
            row.classList.remove("hidden");
          }
        });
      });
    });
  </script>
</.app>
