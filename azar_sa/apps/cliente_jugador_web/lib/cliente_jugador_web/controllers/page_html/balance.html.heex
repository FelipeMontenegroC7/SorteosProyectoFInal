<.app flash={@flash}>
  <div class="max-w-2xl mx-auto space-y-6">
    <h1 class="text-3xl font-bold text-base-content">Mi Balance</h1>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div class="card bg-base-100 shadow-md border border-base-300">
        <div class="card-body items-center text-center py-6">
          <p class="text-xs text-base-content/50 uppercase font-semibold">Saldo actual</p>
          <p class="text-3xl font-bold text-success">$<%= @saldo %></p>
        </div>
      </div>

      <div class="card bg-base-100 shadow-md border border-base-300">
        <div class="card-body items-center text-center py-6">
          <p class="text-xs text-base-content/50 uppercase font-semibold">Ingresado</p>
          <p class="text-2xl font-bold text-base-content">$<%= @ingresado %></p>
        </div>
      </div>

      <div class="card bg-base-100 shadow-md border border-base-300">
        <div class="card-body items-center text-center py-6">
          <p class="text-xs text-base-content/50 uppercase font-semibold">Gastado</p>
          <p class="text-2xl font-bold text-error">$<%= @gastado %></p>
        </div>
      </div>
    </div>

    <div class="card bg-base-100 shadow-md border border-base-300">
      <div class="card-body">
        <h3 class="font-bold text-lg mb-3">Resumen</h3>
        <div class="space-y-3 text-sm">
          <div class="flex justify-between border-b border-base-300 pb-2">
            <span class="text-base-content/60">Total ingresado</span>
            <span class="font-semibold text-success">+$<%= @ingresado %></span>
          </div>
          <div class="flex justify-between border-b border-base-300 pb-2">
            <span class="text-base-content/60">Total gastado en compras</span>
            <span class="font-semibold text-error">-$<%= @gastado %></span>
          </div>
          <div class="flex justify-between pt-2">
            <span class="font-semibold">Balance neto</span>
            <span class="font-bold text-xl text-primary">$<%= @ingresado - @gastado %></span>
          </div>
        </div>
      </div>
    </div>

    <div class="text-center">
      <a href={~p"/recargar"} class="btn btn-success gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        Recargar más saldo
      </a>
    </div>
  </div>
</.app>
