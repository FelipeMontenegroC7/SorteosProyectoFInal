<.app flash={@flash}>
  <div class="space-y-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold text-base-content">Sorteos Disponibles</h1>
        <p class="text-base-content/60 mt-1">Selecciona un sorteo para ver los billetes y comprar</p>
      </div>
      
      <div class="flex gap-2 bg-base-200 p-1 rounded-xl w-fit">
        <a 
          href="?orden=fecha" 
          class={"px-4 py-2 rounded-lg text-sm font-semibold transition-all #{if @filtro_orden == "fecha", do: "bg-base-100 shadow-sm text-primary", else: "text-base-content/50 hover:text-base-content"}"}
        >
          Próximos Sorteos
        </a>
        <a 
          href="?orden=premio" 
          class={"px-4 py-2 rounded-lg text-sm font-semibold transition-all #{if @filtro_orden == "premio", do: "bg-base-100 shadow-sm text-primary", else: "text-base-content/50 hover:text-base-content"}"}
        >
          Mejores Premios
        </a>
      </div>
    </div>

    <%= if @sorteos == [] do %>
      <div class="card bg-base-100 shadow-md border border-base-300">
        <div class="card-body items-center text-center py-12">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 text-base-content/20 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" /></svg>
          <p class="text-lg font-medium text-base-content/50">No hay sorteos activos</p>
          <p class="text-sm text-base-content/40">El administrador los creará pronto.</p>
        </div>
      </div>
    <% else %>
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
        <%= for s <- @sorteos do %>
          <div class="card bg-base-100 border border-base-300 shadow-md hover-lift hover:border-primary/30 transition-all duration-300">
            <div class="card-body">
              <h3 class="card-title text-xl gradient-text">{s.nombre}</h3>
              <p class="text-xs text-base-content/50 mt-1 capitalize font-medium">se juega el: <%= formatear_fecha(s.fecha) %></p>

              <div class="bg-base-200 rounded-xl p-3 my-4 border border-base-300 grid grid-cols-2 gap-y-3 gap-x-2">
                <div class="text-center">
                  <p class="text-[10px] text-base-content/50 uppercase font-bold mb-1">Billetes</p>
                  <p class="text-lg font-black font-mono"><%= s.cantidad_billetes %></p>
                </div>
                <div class="text-center border-l border-base-300">
                  <p class="text-[10px] text-base-content/50 uppercase font-bold mb-1">Fracciones</p>
                  <p class="text-lg font-black font-mono"><%= s.fracciones %></p>
                </div>
                <div class="text-center border-t border-base-300 pt-3 mt-1">
                  <p class="text-[10px] text-base-content/50 uppercase font-bold mb-1">Premio Mayor</p>
                  <p class="text-lg font-black font-mono text-primary">
                    $<%= s.premios |> Enum.map(& &1.valor) |> Enum.max(fn -> 0 end) %>
                  </p>
                </div>
                <div class="text-center border-t border-l border-base-300 pt-3 mt-1">
                  <p class="text-[10px] text-base-content/50 uppercase font-bold mb-1">Precio Fracción</p>
                  <p class="text-lg font-black font-mono text-success">$<%= div(s.valor_billete, max(s.fracciones, 1)) %></p>
                </div>
              </div>

              <div class="card-actions">
                <a href={"/sorteos/#{s.nombre}"} class="btn btn-success btn-sm w-full">
                  Ver Billetes →
                </a>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</.app>
