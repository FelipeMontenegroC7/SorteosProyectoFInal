<.app flash={@flash}>
  <div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold text-base-content">Mis Boletos</h1>
        <p class="text-base-content/60 mt-1">Tus fracciones compradas organizadas por sorteo</p>
      </div>
      <div class="flex items-center gap-4">
        <form action="/mis-boletos" method="get" class="flex items-center gap-2">
          <select name="sorteo" class="select select-bordered select-sm" onchange="this.form.submit()">
            <option value="todos" selected={@filtro_sorteo == "todos"}>Todos los sorteos</option>
            <%= for nombre <- @nombres_sorteos do %>
              <option value={nombre} selected={@filtro_sorteo == nombre}><%= nombre %></option>
            <% end %>
          </select>
        </form>
        <div class="form-control bg-base-200/50 px-3 py-1 rounded-lg border border-base-300">
          <label class="label cursor-pointer gap-2 m-0 p-0">
            <span class="label-text text-xs font-semibold text-base-content/60">Ocultar finalizados</span>
            <input type="checkbox" class="toggle toggle-primary toggle-sm" id="toggle-finished" />
          </label>
        </div>
      </div>
    </div>

    <%= if @jugador && @boletos == [] do %>
      <div class="card bg-base-100 shadow-md border border-base-300">
        <div class="card-body items-center text-center py-12">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 text-base-content/20 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" /></svg>
          <p class="text-lg font-medium text-base-content/50">No tienes boletos aún</p>
          <p class="text-sm text-base-content/40">Visita un sorteo para comprar fracciones.</p>
          <a href={~p"/"} class="btn btn-primary btn-sm mt-4">Ver Sorteos</a>
        </div>
      </div>
    <% else %>
      <div id="tickets-container" class="space-y-10">
        <% boletos_agrupados = Enum.chunk_by(@boletos, &(&1.sorteo.nombre)) %>
        <%= for grupo_boletos <- boletos_agrupados do %>
          <% sorteo_nombre = hd(grupo_boletos).sorteo.nombre %>
          <div class="sorteo-group">
            <div class="border-b-2 border-base-300 pb-2 mb-6 flex items-center justify-between">
              <h2 class="text-2xl font-bold text-base-content flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" /></svg>
                <%= sorteo_nombre %>
              </h2>
            </div>
            <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3 tickets-grid">
              <%= for b <- grupo_boletos do %>
          <div class={"card bg-base-100 border border-base-300 shadow-md hover:shadow-lg transition-all duration-300 ticket-card #{if b.sorteo.estado == :finalizado, do: "finished-ticket", else: "active-ticket"}"}>
            <div class="card-body p-0">
              <div class="p-5">
                <div class="flex justify-between items-start mb-4">
                  <div>
                    <h3 class="font-bold text-lg text-base-content leading-tight">{b.sorteo.nombre}</h3>
                    <p class="text-[10px] text-base-content/40 uppercase tracking-wider font-bold">
                      <%= String.slice(b.sorteo.fecha, 0, 10) %>
                    </p>
                  </div>
                  <%= if b.sorteo.estado == :activo do %>
                    <span class="badge badge-success badge-sm gap-1">
                      <span class="w-1 h-1 rounded-full bg-white animate-pulse"></span>
                      Activo
                    </span>
                  <% else %>
                    <span class="badge badge-neutral badge-sm">Finalizado</span>
                  <% end %>
                </div>

                <div class="bg-base-200 rounded-xl p-4 border border-base-300 flex justify-between items-center">
                  <div class="text-center">
                    <p class="text-[10px] text-base-content/50 uppercase font-bold mb-1">Billete</p>
                    <p class="text-xl font-black font-mono">#{b.billete_num}</p>
                  </div>
                  <div class="w-px h-8 bg-base-300"></div>
                  <div class="text-center">
                    <p class="text-[10px] text-base-content/50 uppercase font-bold mb-1">Número</p>
                    <p class="text-2xl font-black font-mono text-primary tracking-tighter">{b.numero}</p>
                  </div>
                  <div class="w-px h-8 bg-base-300"></div>
                  <div class="text-center">
                    <p class="text-[10px] text-base-content/50 uppercase font-bold mb-1">Fracciones</p>
                    <p class="text-xl font-black font-mono"><%= length(b.ventas) %></p>
                  </div>
                </div>

                <%= if b.ganancia_total > 0 do %>
                  <div class="alert alert-success py-2 text-sm mt-4 border-none shadow-sm">
                    <span> ¡Ganaste <strong>$<%= b.ganancia_total %></strong>!</span>
                  </div>
                <% end %>
              </div>

              <%!-- Collapse para fracciones --%>
              <div class="collapse bg-base-200/50 rounded-none border-t border-base-300">
                <input type="checkbox" />
                <div class="collapse-title text-xs font-bold flex items-center justify-between py-3 px-5">
                  <span>Ver detalles de fracciones</span>
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                </div>
                <div class="collapse-content px-0">
                  <div class="divide-y divide-base-300">
                    <%= for v <- b.ventas do %>
                      <div class="flex justify-between items-center px-5 py-3 hover:bg-base-200 transition-colors">
                        <div class="text-xs">
                          <span class="font-bold">Fracción #<%= v.fraccion %></span>
                          <p class="text-[10px] text-base-content/40"><%= String.slice(v.inserted_at, 11, 8) %></p>
                        </div>
                        <div class="flex items-center gap-2">
                          <%= if b.sorteo.estado == :activo do %>
                            <form action={"/mis-boletos/#{v.id}/devolver"} method="post" onsubmit="return confirm('¿Devolver esta fracción?');">
                              <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
                              <button type="submit" class="btn btn-ghost btn-xs text-error hover:bg-error/10">Devolver</button>
                            </form>
                          <% else %>
                            <span class="text-[10px] opacity-50 font-bold uppercase">Cerrado</span>
                          <% end %>
                        </div>
                      </div>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% end %>
        </div>
      </div>
    <% end %>
      </div>
    <% end %>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", function() {
      const toggle = document.getElementById("toggle-finished");
      if (!toggle) return;

      toggle.addEventListener("change", function() {
        const finishedCards = document.querySelectorAll(".finished-ticket");
        finishedCards.forEach(card => {
          if (this.checked) {
            card.classList.add("hidden");
          } else {
            card.classList.remove("hidden");
          }
        });
        
        // Hide empty groups
        const groups = document.querySelectorAll(".sorteo-group");
        groups.forEach(group => {
          const visibleCards = group.querySelectorAll(".ticket-card:not(.hidden)");
          if (visibleCards.length === 0) {
             group.classList.add("hidden");
          } else {
             group.classList.remove("hidden");
          }
        });
      });
    });
  </script>
</.app>
